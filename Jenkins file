pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Compile') {
            steps {
                echo 'Compiling Java code...'
                bat 'javac Addition.java'
            }
        }

        stage('Run') {
            steps {
                echo 'Running Java program...'
                bat 'java Addition'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing Addition program...'
                bat 'java Addition'
            }
        }
    }

    post {
        success {
            echo 'Build and execution successful!'
        }

        failure {
            echo 'Build failed!'
        }
    }
}